APP_NAME="Sistema Tickets ISTU"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/El_Salvador
APP_URL=https://tickets.istu.gob.sv

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistema_tickets
DB_USERNAME=sistema_tickets_app
DB_PASSWORD=

# 'database' funciona sin infraestructura adicional. Si se provisiona Redis en
# el servidor, cambiar a 'redis' junto con CACHE_STORE reduce escrituras a MySQL
# por request (requiere agregar predis/predis o la extensión phpredis primero).
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# Colas: 'database' funciona, pero requiere Supervisor corriendo `queue:work`
# permanentemente (ver deploy/laravel-worker.conf). 'redis' es preferible si
# Redis ya está disponible en el servidor.
QUEUE_CONNECTION=database

# Misma recomendación que SESSION_DRIVER: 'redis' evita escrituras extra en
# MySQL en cada candado Cache::add() de envíos duplicados (ver composer.json:
# hay que agregar predis/predis o la extensión phpredis antes de activarlo).
CACHE_STORE=database
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="Help Desk ISTU"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb: en producción debe correr como servicio persistente (systemd), no
# manualmente. Puerto interno 8080 detrás de un reverse proxy (Nginx/Apache)
# que termine TLS y exponga el WebSocket en el puerto 443 estándar.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
